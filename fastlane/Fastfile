default_platform(:android)

platform :android do
  desc "Build and submit Android app to Google Play Store"
  lane :playstore do
    # Requires base64 encoded keystore and properties to be injected by CI
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android"
    )

    supply(
      track: "production",
      aab: "android/app/build/outputs/bundle/release/app-release.aab"
    )
  end
end

platform :ios do
  desc "Build and submit iOS app to Apple App Store"
  lane :appstore do
    setup_ci

    # Setup App Store Connect API Key for authentication
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_B64"],
      is_key_content_base64: true,
      in_house: false
    )

    # Download signing certificates
    match(
      type: "appstore",
      readonly: false,
      skip_confirmation: true,
      git_url: ENV["MATCH_GIT_URL"]
    )

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"],
      xcodeproj: "ios/App/App.xcodeproj"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: "JFVKWF4NC6",
      bundle_identifier: "com.medspark.app",
      profile_name: "match AppStore com.medspark.app",
      targets: ["App"],
      code_sign_identity: "Apple Distribution"
    )

    build_app(
      scheme: "App",
      project: "ios/App/App.xcodeproj",
      export_method: "app-store",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM=JFVKWF4NC6",
      export_team_id: "JFVKWF4NC6"
    )

    upload_to_app_store(
      skip_screenshots: true,
      skip_metadata: true
    )
  end
end
