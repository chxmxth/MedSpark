+export interface Message {
+  id: string;
+  sender: "user" | "patient" | "system" | "assistant";
+  text: string;
+  timestamp: string;
+}
+
+export interface VitalSigns {
+  heartRate: number;
+  bloodPressure: string;
+  oxygenSat: number;
+  respRate: number;
+}
+
+export interface PatientCase {
+  id: string;
+  name: string;
+  age: number;
+  gender: "M" | "F";
+  complaint: string;
+  avatar: string;
+  historyOfPresentIllness: string;
+  vitals: VitalSigns;
+  ecgDescription: string;
+  labs: {
+    fbc: string;
+    ue: string;
+    lft: string;
+    troponin: string;
+  };
+  imaging: {
+    cxr: string;
+    ct: string;
+  };
+  physicalExamPrompt: string;
