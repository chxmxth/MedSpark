@@ -0,0 +1,152 @@
+name: MediSpark Production Deployments
+
+on:
+  push:
+    branches:
+      - main # Or your default production branch
+
+jobs:
+  build-and-deploy-web:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout Code
+        uses: actions/checkout@v4
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+
+      - name: Install Dependencies
+        run: npm ci
+
+      - name: Build Web Platform
+        run: npm run build
+
+      - id: auth
+        uses: google-github-actions/auth@v2
+        with:
+          credentials_json: ${{ secrets.GCP_CREDENTIALS }}
+
+      - name: Set up Cloud SDK
+        uses: google-github-actions/setup-gcloud@v2
+
+      - name: Configure Docker Auth
+        run: gcloud auth configure-docker asia-southeast1-docker.pkg.dev
+
+      - name: Build and Push Docker Image
+        env:
+          IMAGE_NAME: asia-southeast1-docker.pkg.dev/medispark-498009/cloud-run-source-deploy/medispark-api
+        run: |
+          docker build -t $IMAGE_NAME:${{ github.sha }} .
+          docker push $IMAGE_NAME:${{ github.sha }}
+
+      - name: Deploy to Cloud Run
+        uses: google-github-actions/deploy-cloudrun@v2
+        with:
+          service: medispark-api
+          region: asia-southeast1
+          image: asia-southeast1-docker.pkg.dev/medispark-498009/cloud-run-source-deploy/medispark-api:${{ github.sha }}
+          flags: '--allow-unauthenticated'
+          env_vars: |
+            GEMINI_API_KEY=${{ secrets.GEMINI_API_KEY }}
+            REVENUECAT_SECRET_KEY=${{ secrets.REVENUECAT_SECRET_KEY }}
+            REVENUECAT_IOS_API_KEY=${{ secrets.REVENUECAT_IOS_API_KEY }}
+            REVENUECAT_ANDROID_API_KEY=${{ secrets.REVENUECAT_ANDROID_API_KEY }}
+            UMLS_API_KEY=${{ secrets.UMLS_API_KEY }}
+
+      - name: Map Custom Domain
+        run: |
+          gcloud beta run domain-mappings create --service medispark-api --domain medispark.com --region asia-southeast1 || true
+
+  build-and-deploy-android:
+    runs-on: ubuntu-latest
+    needs: build-and-deploy-web
+    steps:
+      - name: Checkout Code
+        uses: actions/checkout@v4
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+
+      - name: Install Dependencies
+        run: npm ci
+
+      - name: Sync Capacitor Web Assets
+        run: |
+          npm run build
+          npx cap sync android
+
+      - name: Setup Ruby for Fastlane
+        uses: ruby/setup-ruby@v1
+        with:
+          ruby-version: 3.2
+          bundler-cache: true
+
+      - name: Install Fastlane
+        run: gem install fastlane
+
+      - name: Decode Keystore
+        env:
+          ENCODED_KEYSTORE: ${{ secrets.ANDROID_KEYSTORE_B64 }}
+        run: |
+          echo "$ENCODED_KEYSTORE" | base64 -d > android/app/release.jks
+
+      - name: Build & Deploy to Play Store
+        env:
+          PLAY_STORE_KEY_JSON: ${{ secrets.PLAY_STORE_KEY_JSON }}
+          ANDROID_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
+          ANDROID_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
+          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
+        run: |
+          echo "$PLAY_STORE_KEY_JSON" > fastlane/play_store_key.json
+          # Write environment variables for gradle signing config
+          echo "ORG_GRADLE_PROJECT_MYAPP_UPLOAD_STORE_FILE=release.jks" >> ~/.gradle/gradle.properties
+          echo "ORG_GRADLE_PROJECT_MYAPP_UPLOAD_KEY_ALIAS=$ANDROID_KEY_ALIAS" >> ~/.gradle/gradle.properties
+          echo "ORG_GRADLE_PROJECT_MYAPP_UPLOAD_STORE_PASSWORD=$KEYSTORE_PASSWORD" >> ~/.gradle/gradle.properties
+          echo "ORG_GRADLE_PROJECT_MYAPP_UPLOAD_KEY_PASSWORD=$ANDROID_KEY_PASSWORD" >> ~/.gradle/gradle.properties
+          fastlane android playstore
+
+  build-and-deploy-ios:
+    runs-on: macos-latest
+    needs: build-and-deploy-web
+    steps:
+      - name: Checkout Code
+        uses: actions/checkout@v4
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 22
+
+      - name: Install Dependencies
+        run: npm ci
+
+      - name: Sync Capacitor Web Assets
+        run: |
+          npm run build
+          npx cap sync ios
+
+      - name: Setup Ruby for Fastlane
+        uses: ruby/setup-ruby@v1
+        with:
+          ruby-version: 3.2
+          bundler-cache: true
+
+      - name: Install Fastlane
+        run: gem install fastlane
+
+      - name: Build & Deploy to App Store
+        env:
+          MATCH_PASSWORD: ${{ secrets.MATCH_PASSWORD }}
+          MATCH_GIT_BASIC_AUTHORIZATION: ${{ secrets.MATCH_GIT_BASIC_AUTHORIZATION }}
+          MATCH_GIT_URL: ${{ secrets.MATCH_GIT_URL }}
+          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
+          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
+          ASC_KEY_B64: ${{ secrets.ASC_KEY_B64 }}
+        run: |
+          echo "$ASC_KEY_B64" | base64 -d > fastlane/asc_key.p8
+          export ASC_KEY_FILEPATH="fastlane/asc_key.p8"
+          fastlane ios appstore
